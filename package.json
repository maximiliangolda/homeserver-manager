{
  "name": "homeserver-manager",
  "version": "1.0.0",
  "description": "Selbstgehostetes Dashboard zur zentralen Verwaltung von Homeservern: Verfügbarkeits-Monitoring, Services & Links, SSH-Terminal im Browser, Serversteuerung, DNS-Abfragen.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "package": "bash scripts/build-package.sh"
  },
  "keywords": [
    "homeserver",
    "dashboard",
    "monitoring",
    "selfhosted",
    "ssh",
    "uptime"
  ],
  "license": "MIT",
  "author": "Maximilian Golda",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0"
  }
}
